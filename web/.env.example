# ==============================================================================
# VOLUM3TRIKA² INGENIERÍA Y SERVICIOS, SRL. - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local, o configúralo
# en las variables de entorno de tu proveedor de hosting (Vercel, Cloudflare, etc.)

# ------------------------------------------------------------------------------
# 1. URL DEL SITIO (OBLIGATORIO)
# ------------------------------------------------------------------------------
# En local: http://localhost:3000 o http://127.0.0.1:3000
# En producción: https://volum3trika.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVICIO DE CORREO TRANSACCIONAL (RESEND)
# ------------------------------------------------------------------------------
# Regístrate gratis en https://resend.com (Plan gratuito incluye 3,000 correos/mes).
# Genera tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=

# Dirección de correo remitente verificada en Resend:
# - En producción: cotizaciones@volum3trika.com (tras verificar el dominio en Resend)
# - En pruebas iniciales: onboarding@resend.dev (solo puede enviar a tu propio correo de cuenta)
QUOTE_FROM_EMAIL=cotizaciones@volum3trika.com

# Dirección de destino donde la directiva técnica recibirá las cotizaciones:
QUOTE_TO_EMAIL=volum3trika@gmail.com

# ------------------------------------------------------------------------------
# 3. PROTECCIÓN ANTI-BOT (CLOUDFLARE TURNSTILE)
# ------------------------------------------------------------------------------
# Regístrate en https://dash.cloudflare.com/?to=/:account/turnstile
# Crea un widget con modo "Managed" o "Non-interactive" para tu dominio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. CANAL OFICIAL DE ATENCIÓN DIRECTA (WHATSAPP)
# ------------------------------------------------------------------------------
# Número de teléfono con prefijo de país, solo dígitos numéricos (RD: 18093898022).
NEXT_PUBLIC_WHATSAPP_NUMBER=18093898022

# ------------------------------------------------------------------------------
# 5. SANITY CMS (OPCIONAL - GESTIÓN DINÁMICA DE PROYECTOS)
# ------------------------------------------------------------------------------
# Proyecto preconfigurado o nuevo en sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=xlplzrew
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=xlplzrew
SANITY_STUDIO_DATASET=production
# Token con permisos de escritura (solo necesario si ejecutas 'npm run seed')
SANITY_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 6. ANALÍTICA WEB (OPCIONAL)
# ------------------------------------------------------------------------------
# ID de medición de Google Analytics 4 (ej. G-XXXXXXXXXX). Solo se activa si el
# visitante acepta el aviso de consentimiento en cumplimiento de privacidad.
NEXT_PUBLIC_GA_ID=
