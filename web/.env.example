# URL definitiva del sitio. Usa localhost durante el desarrollo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sanity: crea un proyecto y dataset desde sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Solo para el script de carga inicial; nunca usar NEXT_PUBLIC para este token.
SANITY_WRITE_TOKEN=
# Correo: dominio remitente verificado en Resend.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=volum3trika@gmail.com
# Turnstile: se necesitan ambas claves. Obligatorio en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Número confirmado para WhatsApp, con prefijo de país, solo dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=18093898022
# Analítica opcional; se carga solo tras aceptar el aviso.
NEXT_PUBLIC_GA_ID=
